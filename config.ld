project = "Micro2D Engine"
title = "The Micro2D Engine Documentation"
description = "Micro2D: The Code-Only 2D engine"
dir = "./doc"
format = "markdown"
all = true
full_description = "Micro2D acts as an abstraction layer built on top of Lua Player Plus, featuring an architecture inspired by Unity Engine.\n\nThis engine was custom-made for my game Tile Puzzle Ultimate (originally built with Unity), with the goal of offering a Unity-inspired structure and facilitating the port to the Nintendo 3DS.\n\nBelow you can see all the modules available in the Micro2D engine:"
file = {
    "./romfs/micro2d/components",
    "./romfs/micro2d/core",
    "./romfs/micro2d/debugger",
    "./romfs/micro2d/fonts",
    "./romfs/micro2d/gameobject",
    "./romfs/micro2d/input",
    "./romfs/micro2d/renderer",
    "./romfs/micro2d/time",
    "./romfs/micro2d/m2d_settings.lua",
}